{
  "name": "@lionad/use-scrollbar-nuxt",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "Nuxt module for @lionad/use-scrollbar: auto-imports composables and injects scrollbar styles",
  "author": "Lionad",
  "license": "MIT",
  "homepage": "https://github.com/Lionad-Morotar/use-scrollbar",
  "repository": "https://github.com/Lionad-Morotar/use-scrollbar",
  "keywords": [
    "scrollbar",
    "virtual",
    "scroll",
    "nuxt",
    "nuxt-module",
    "vue3"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "check:types": "vue-tsc --noEmit",
    "check:types:fixture": "vue-tsc -p ./fixture/tsconfig.json --noEmit",
    "check:fixture": "nuxi build ./fixture"
  },
  "peerDependencies": {
    "@lionad/use-scrollbar": "^0.4.11"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.1"
  },
  "devDependencies": {
    "@lionad/use-scrollbar": "workspace:*",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@types/node": "^24.13.3",
    "nuxt": "^4.5.1",
    "typescript": "~5.9.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

{
  "name": "use-scrollbar-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "description": "Monorepo for @lionad/use-scrollbar and its Nuxt module",
  "author": "Lionad",
  "license": "MIT",
  "homepage": "https://github.com/Lionad-Morotar/use-scrollbar",
  "repository": "https://github.com/Lionad-Morotar/use-scrollbar",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm dev:playground",
    "dev:playground": "pnpm --filter use-scrollbar-playground dev",
    "serve": "pnpm dev",
    "build": "pnpm -r --if-present build",
    "check:types": "pnpm -r --if-present check:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "postcss-preset-env": "^11.3.2",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,vue,json,md,yml,yaml}": [
      "eslint --fix"
    ]
  }
}
